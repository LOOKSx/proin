{
  "version": 2,
  "name": "proin",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/offline",
      "destination": "/index-offline.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
